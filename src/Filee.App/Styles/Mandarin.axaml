<!--
  Mandarin's look: neutral liquid-glass panels, applied over the Soft style to every window that isn't in the Material
  You style.

  The rules it keeps (liquid glass, translated to Avalonia):
    • The material is colourless: near-white frosted glass in light mode, graphite in dark. Colour comes from what is
      behind it and from the accent (Settings > Theme), used as a highlight: the default button, a switch, a slider's
      lit track, the wheel's lit slice, the progress ring.
    • Surfaces on a panel are glass: white at a low alpha with a brighter rim at the top.
    • Children of a glass card paint no second surface: rows and groups inside are separated by space and type.
    • Content stays readable: text is near-black / near-white; the strongest glass is kept for floating controls.
    • macOS: the settings window lets the desktop show through, blurred (vibrancy), unless Reduce Transparency is on.

  Colours that differ between light and dark live in the theme dictionaries below.
-->
<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="using:Filee.App.Views">

  <Styles.Resources>
    <ResourceDictionary>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
          <LinearGradientBrush x:Key="MandarinWindowBrush" StartPoint="20%,0%" EndPoint="80%,100%">
            <GradientStop Color="#FFFDFDFE" Offset="0" />
            <GradientStop Color="#FFF5F5F8" Offset="0.55" />
            <GradientStop Color="#FFEEEFF3" Offset="1" />
          </LinearGradientBrush>
          <LinearGradientBrush x:Key="MandarinVibrantBrush" StartPoint="20%,0%" EndPoint="80%,100%">
            <GradientStop Color="#D9FDFDFE" Offset="0" />
            <GradientStop Color="#CCF5F5F8" Offset="1" />
          </LinearGradientBrush>
          <LinearGradientBrush x:Key="MandarinGlassBrush" StartPoint="0%,0%" EndPoint="0%,100%">
            <GradientStop Color="#B3FFFFFF" Offset="0" />
            <GradientStop Color="#80FFFFFF" Offset="1" />
          </LinearGradientBrush>
          <LinearGradientBrush x:Key="MandarinRimBrush" StartPoint="0%,0%" EndPoint="0%,100%">
            <GradientStop Color="#FFFFFFFF" Offset="0" />
            <GradientStop Color="#1F000000" Offset="1" />
          </LinearGradientBrush>
          <SolidColorBrush x:Key="MandarinControlBrush" Color="#CCFFFFFF" />
          <SolidColorBrush x:Key="MandarinControlHoverBrush" Color="#F2FFFFFF" />
          <SolidColorBrush x:Key="MandarinControlPressedBrush" Color="#0F000000" />
          <SolidColorBrush x:Key="MandarinHairlineBrush" Color="#1F000000" />
          <SolidColorBrush x:Key="MandarinTitleBrush" Color="#FF1D1D1F" />
          <SolidColorBrush x:Key="MandarinTextBrush" Color="#FF1D1D1F" />
          <SolidColorBrush x:Key="MandarinMutedBrush" Color="#FF6E6E73" />
          <SolidColorBrush x:Key="MandarinSectionBrush" Color="#FF48484A" />
          <SolidColorBrush x:Key="MandarinWellBrush" Color="#FF1C1C1E" />
          <SolidColorBrush x:Key="MandarinCloseBrush" Color="#12000000" />
          <BoxShadows x:Key="MandarinPanelShadow">0 1 3 0 #1A000000, 0 18 40 0 #2E000000</BoxShadows>
          <!-- Fluent's inputs on the glass -->
          <SolidColorBrush x:Key="TextControlBackground" Color="#CCFFFFFF" />
          <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#F2FFFFFF" />
          <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#FFFFFFFF" />
          <SolidColorBrush x:Key="TextControlBorderBrush" Color="#1F000000" />
          <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="#33000000" />
          <SolidColorBrush x:Key="ComboBoxBackground" Color="#CCFFFFFF" />
          <SolidColorBrush x:Key="ComboBoxBackgroundPointerOver" Color="#F2FFFFFF" />
          <SolidColorBrush x:Key="ComboBoxBorderBrush" Color="#1F000000" />
          <SolidColorBrush x:Key="SliderTrackFill" Color="#1F000000" />
          <SolidColorBrush x:Key="SliderTrackFillPointerOver" Color="#29000000" />
          <SolidColorBrush x:Key="SliderTrackFillPressed" Color="#33000000" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
          <LinearGradientBrush x:Key="MandarinWindowBrush" StartPoint="20%,0%" EndPoint="80%,100%">
            <GradientStop Color="#FF2E2E33" Offset="0" />
            <GradientStop Color="#FF242428" Offset="0.55" />
            <GradientStop Color="#FF1C1C20" Offset="1" />
          </LinearGradientBrush>
          <LinearGradientBrush x:Key="MandarinVibrantBrush" StartPoint="20%,0%" EndPoint="80%,100%">
            <GradientStop Color="#CC2E2E33" Offset="0" />
            <GradientStop Color="#D91C1C20" Offset="1" />
          </LinearGradientBrush>
          <LinearGradientBrush x:Key="MandarinGlassBrush" StartPoint="0%,0%" EndPoint="0%,100%">
            <GradientStop Color="#1FFFFFFF" Offset="0" />
            <GradientStop Color="#0FFFFFFF" Offset="1" />
          </LinearGradientBrush>
          <LinearGradientBrush x:Key="MandarinRimBrush" StartPoint="0%,0%" EndPoint="0%,100%">
            <GradientStop Color="#4DFFFFFF" Offset="0" />
            <GradientStop Color="#12FFFFFF" Offset="1" />
          </LinearGradientBrush>
          <SolidColorBrush x:Key="MandarinControlBrush" Color="#1FFFFFFF" />
          <SolidColorBrush x:Key="MandarinControlHoverBrush" Color="#33FFFFFF" />
          <SolidColorBrush x:Key="MandarinControlPressedBrush" Color="#14FFFFFF" />
          <SolidColorBrush x:Key="MandarinHairlineBrush" Color="#24FFFFFF" />
          <SolidColorBrush x:Key="MandarinTitleBrush" Color="#FFF5F5F7" />
          <SolidColorBrush x:Key="MandarinTextBrush" Color="#FFF5F5F7" />
          <SolidColorBrush x:Key="MandarinMutedBrush" Color="#FF98989D" />
          <SolidColorBrush x:Key="MandarinSectionBrush" Color="#FFC7C7CC" />
          <SolidColorBrush x:Key="MandarinWellBrush" Color="#FF0E0E10" />
          <SolidColorBrush x:Key="MandarinCloseBrush" Color="#1AFFFFFF" />
          <BoxShadows x:Key="MandarinPanelShadow">0 1 3 0 #40000000, 0 18 40 0 #66000000</BoxShadows>
          <SolidColorBrush x:Key="TextControlBackground" Color="#1FFFFFFF" />
          <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#2EFFFFFF" />
          <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#FF2C2C30" />
          <SolidColorBrush x:Key="TextControlBorderBrush" Color="#2EFFFFFF" />
          <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="#47FFFFFF" />
          <SolidColorBrush x:Key="ComboBoxBackground" Color="#1FFFFFFF" />
          <SolidColorBrush x:Key="ComboBoxBackgroundPointerOver" Color="#2EFFFFFF" />
          <SolidColorBrush x:Key="ComboBoxBorderBrush" Color="#2EFFFFFF" />
          <SolidColorBrush x:Key="SliderTrackFill" Color="#2EFFFFFF" />
          <SolidColorBrush x:Key="SliderTrackFillPointerOver" Color="#3DFFFFFF" />
          <SolidColorBrush x:Key="SliderTrackFillPressed" Color="#4DFFFFFF" />
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
      <!-- Sliders: the lit track is the accent (SoftPalette sets SliderTrackValueFill), the thumb a white pill -->
      <SolidColorBrush x:Key="SliderThumbBackground" Color="#FFFFFFFF" />
      <SolidColorBrush x:Key="SliderThumbBackgroundPointerOver" Color="#FFFFFFFF" />
      <SolidColorBrush x:Key="SliderThumbBackgroundPressed" Color="#FFF5F1EE" />
      <x:Double x:Key="SliderHorizontalThumbWidth">28</x:Double>
      <x:Double x:Key="SliderHorizontalThumbHeight">20</x:Double>
      <CornerRadius x:Key="SliderThumbCornerRadius">10</CornerRadius>
      <!-- The lit part of a slider: the warm red-orange of the designs, in both themes. -->
      <LinearGradientBrush x:Key="MandarinTrackBrush" StartPoint="0%,0%" EndPoint="100%,0%">
        <GradientStop Color="#FFFF2E1A" Offset="0" />
        <GradientStop Color="#FFFF5A1F" Offset="1" />
      </LinearGradientBrush>
    </ResourceDictionary>
  </Styles.Resources>

  <!-- ───────── The window: the frosted backdrop every glass surface sits on ───────── -->
  <Style Selector="Window:not(.material-you)">
    <Setter Property="Background" Value="{DynamicResource MandarinWindowBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource MandarinTextBrush}" />
  </Style>
  <!-- macOS vibrancy (the settings window): the desktop shows through, blurred, under a frosted wash. -->
  <Style Selector="Window.vibrant:not(.material-you)">
    <Setter Property="Background" Value="{DynamicResource MandarinVibrantBrush}" />
  </Style>
  <Style Selector="Window:not(.material-you) TextBlock.caption:not(.danger):not(.warning), Window:not(.material-you) TextBlock.label:not(.danger):not(.warning), Window:not(.material-you) TextBlock.muted:not(.danger):not(.warning)">
    <Setter Property="Foreground" Value="{DynamicResource MandarinMutedBrush}" />
  </Style>
  <Style Selector="Window:not(.material-you) TextBlock.h1, Window:not(.material-you) TextBlock.h2">
    <Setter Property="Foreground" Value="{DynamicResource MandarinTitleBrush}" />
  </Style>

  <!-- A panel's title, centred in its title bar (Edit Photo, Add BG) -->
  <Style Selector="TextBlock.panel-title">
    <Setter Property="FontSize" Value="19" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Foreground" Value="{DynamicResource MandarinTitleBrush}" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <!-- A group's heading ("Light", "Background"): a strong grey, quieter than the title -->
  <Style Selector="TextBlock.section">
    <Setter Property="FontSize" Value="13.5" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource MandarinSectionBrush}" />
  </Style>
  <!-- A slider's value at the end of its row ("+0", "0.00 EV", "100 %") -->
  <Style Selector="TextBlock.value">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Foreground" Value="{DynamicResource MandarinTextBrush}" />
    <Setter Property="HorizontalAlignment" Value="Right" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <!-- A thin line between a panel's title bar, its body and its button row -->
  <Style Selector="Border.hairline">
    <Setter Property="Height" Value="1" />
    <Setter Property="Background" Value="{DynamicResource MandarinHairlineBrush}" />
    <Setter Property="Opacity" Value="0.6" />
  </Style>

  <!-- ───────── Glass surfaces ───────── -->
  <Style Selector="Window:not(.material-you) Border.card, Border.glass">
    <Setter Property="Background" Value="{DynamicResource MandarinGlassBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource MandarinRimBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BoxShadow" Value="0 1 2 0 #12000000" />
  </Style>
  <!-- A floating panel's own body (a tool window that is a transparent overlay, Trim Audio): the warm gradient itself,
       rounded, with a soft lift. -->
  <Style Selector="Border.mandarin-panel">
    <Setter Property="Background" Value="{DynamicResource MandarinWindowBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource MandarinRimBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="26" />
    <Setter Property="BoxShadow" Value="{DynamicResource MandarinPanelShadow}" />
  </Style>
  <!-- The dark well a picture is previewed in, so it stands out (Edit Photo) -->
  <Style Selector="Border.preview-well">
    <Setter Property="Background" Value="{DynamicResource MandarinWellBrush}" />
    <Setter Property="CornerRadius" Value="16" />
    <Setter Property="ClipToBounds" Value="True" />
  </Style>
  <!-- A light well for a canvas preview (Add BG): glass, so the canvas's own background reads against it -->
  <Style Selector="Border.canvas-well">
    <Setter Property="Background" Value="{DynamicResource MandarinGlassBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource MandarinRimBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="18" />
  </Style>

  <!-- ───────── Buttons: glass panes; the accent one keeps the accent colour and its readable label ───────── -->
  <Style Selector="Window:not(.material-you) Button:not(.icon):not(.ghost):not(.accent):not(.navlink):not(.choice-card):not(.close-round) /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource MandarinControlBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource MandarinRimBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource MandarinTextBrush}" />
  </Style>
  <Style Selector="Window:not(.material-you) Button:not(.icon):not(.ghost):not(.accent):not(.navlink):not(.choice-card):not(.close-round):pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource MandarinControlHoverBrush}" />
  </Style>
  <Style Selector="Window:not(.material-you) Button:not(.icon):not(.ghost):not(.accent):not(.navlink):not(.choice-card):not(.close-round):pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource MandarinControlPressedBrush}" />
  </Style>
  <!-- The round close button at the top left of a panel -->
  <Style Selector="Button.close-round">
    <Setter Property="Width" Value="32" />
    <Setter Property="Height" Value="32" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="CornerRadius" Value="16" />
    <Setter Property="Background" Value="{DynamicResource MandarinCloseBrush}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Foreground" Value="{DynamicResource MandarinTitleBrush}" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.close-round:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource MandarinControlHoverBrush}" />
  </Style>

  <!-- A small round reset arrow at the end of a slider's row -->
  <Style Selector="Button.reset">
    <Setter Property="Width" Value="24" />
    <Setter Property="Height" Value="24" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Foreground" Value="{DynamicResource MandarinMutedBrush}" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.reset:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource MandarinControlHoverBrush}" />
  </Style>

  <!-- ───────── Sliders: a thin warm track and a white pill thumb ───────── -->
  <Style Selector="Window:not(.material-you) Slider:horizontal /template/ Thumb#PART_Thumb">
    <Setter Property="Width" Value="28" />
    <Setter Property="Height" Value="20" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Background" Value="White" />
    <Setter Property="BorderBrush" Value="#26000000" />
    <Setter Property="BorderThickness" Value="0.5" />
    <Setter Property="Transitions">
      <Transitions>
        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.16" Easing="CubicEaseOut" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Window:not(.material-you) Slider:horizontal /template/ Thumb#PART_Thumb:pointerover">
    <Setter Property="RenderTransform" Value="scale(1.06)" />
  </Style>
  <Style Selector="Window:not(.material-you) Slider:horizontal /template/ Thumb#PART_Thumb:pressed">
    <Setter Property="RenderTransform" Value="scale(1.12)" />
  </Style>

  <!-- ───────── Segmented choices: glass track, the chosen segment a brighter pane ───────── -->
  <Style Selector="Window:not(.material-you) Border.segments">
    <Setter Property="Background" Value="{DynamicResource MandarinControlBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource MandarinRimBrush}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>

  <!-- ───────── Progress: a thin glass track, the accent filling it ───────── -->
  <Style Selector="Window:not(.material-you) ProgressBar">
    <Setter Property="Background" Value="{DynamicResource SliderTrackFill}" />
    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
  </Style>

  <!-- The toast floats over whatever is on screen: its cards are the panel's own frosted surface, not see-through glass,
       so the text reads over any wallpaper. -->
  <Style Selector="v|ToastWindow:not(.material-you) Border.card">
    <Setter Property="Background" Value="{DynamicResource MandarinWindowBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource MandarinRimBrush}" />
    <Setter Property="CornerRadius" Value="18" />
    <Setter Property="BoxShadow" Value="{DynamicResource MandarinPanelShadow}" />
  </Style>

  <!-- Reduce motion (Settings > Theme) keeps the thumb still, as the Soft style does. -->
  <Style Selector="Window.reduced-motion Slider /template/ Thumb#PART_Thumb">
    <Setter Property="Transitions" Value="{x:Null}" />
  </Style>
</Styles>
