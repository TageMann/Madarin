<!-- Mandarin's "Edit Photo" panel (the design's Edit Photo): a floating warm glass panel with the round close button
     and the title on top, the first picture large in a dark well with the light as chosen, then the Light group
     (exposure, brightness, contrast, highlights, shadows, each with its value and a reset), and under it the size,
     format, turn and colour of the pictures (#584), chosen right before they are converted. Convert starts the
     conversions (shown in the toast); Cancel, Esc or closing starts nothing. -->
<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Filee.App.ViewModels"
        x:Class="Filee.App.Views.ImageEditWindow"
        x:DataType="vm:ImageEditViewModel"
        Title="{DynamicResource preset.image_edit}"
        Icon="avares://Filee/Assets/Icons/filee.ico"
        Width="680" Height="900" MinWidth="560" MinHeight="600"
        WindowDecorations="None"
        Background="Transparent"
        TransparencyLevelHint="Transparent"
        WindowStartupLocation="CenterScreen">
  <Window.Resources>
    <StreamGeometry x:Key="Mandarin.Reset">M12 5V2L7 6.5 12 11V8a5 5 0 1 1-5 5H5a7 7 0 1 0 7-8z</StreamGeometry>
  </Window.Resources>
  <Border x:Name="Shell" Classes="mandarin-panel" Margin="12" ClipToBounds="True">
    <Grid RowDefinitions="58,Auto,Auto,*,Auto">
      <!-- Title bar: close and the title; dragging it moves the panel -->
      <Grid x:Name="TitleBar" Background="Transparent">
        <Button Classes="close-round" HorizontalAlignment="Left" Margin="16,0" Click="OnCancel" KeyboardNavigation.IsTabStop="False"
                ToolTip.Tip="{DynamicResource common.close}" AutomationProperties.Name="{DynamicResource common.close}">
          <PathIcon Width="11" Height="11" Data="{StaticResource Icon.Close}" />
        </Button>
        <TextBlock Classes="panel-title" Text="{DynamicResource image_edit.panel_title}" />
      </Grid>
      <Border Grid.Row="1" Classes="hairline" />

      <!-- The first picture as it will look, in a dark well -->
      <Border Grid.Row="2" Classes="preview-well" Margin="20,16,20,6" Height="360">
        <Panel>
          <Image Source="{Binding PreviewImage}" Stretch="Uniform" Margin="12" RenderOptions.BitmapInterpolationMode="HighQuality" />
          <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="12" Padding="10,3" CornerRadius="999" Background="#66000000">
            <TextBlock Text="{Binding Heading}" Foreground="White" FontSize="12" TextTrimming="CharacterEllipsis" MaxWidth="360"
                       ToolTip.Tip="{Binding HeadingTip}" />
          </Border>
        </Panel>
      </Border>

      <ScrollViewer Grid.Row="3">
        <StackPanel Margin="26,10,26,14" Spacing="14">
          <!-- Light -->
          <StackPanel Spacing="4">
            <DockPanel>
              <Button DockPanel.Dock="Right" Classes="ghost" Padding="8,2" FontSize="12" Command="{Binding ResetLightCommand}" CommandParameter="all"
                      Content="{DynamicResource crop.reset}" />
              <TextBlock Classes="section" Text="{DynamicResource image_edit.light}" VerticalAlignment="Center" />
            </DockPanel>
              <Grid ColumnDefinitions="110,*,78,30">
                <TextBlock Text="{DynamicResource image_edit.exposure}" VerticalAlignment="Center" FontSize="13.5" />
                <Slider Grid.Column="1" Minimum="-3" Maximum="3" Value="{Binding Exposure}" TickFrequency="0.05" IsSnapToTickEnabled="True"
                        SmallChange="0.05" LargeChange="0.5" VerticalAlignment="Center" AutomationProperties.Name="{DynamicResource image_edit.exposure}" />
                <TextBlock Grid.Column="2" Classes="value" Text="{Binding ExposureText}" />
                <Button Grid.Column="3" Classes="reset" Command="{Binding ResetLightCommand}" CommandParameter="exposure" HorizontalAlignment="Right"
                        ToolTip.Tip="{DynamicResource crop.reset}" AutomationProperties.Name="{DynamicResource crop.reset}">
                  <PathIcon Width="13" Height="13" Data="{StaticResource Mandarin.Reset}" />
                </Button>
              </Grid>
              <Grid ColumnDefinitions="110,*,78,30">
                <TextBlock Text="{DynamicResource image_edit.brightness}" VerticalAlignment="Center" FontSize="13.5" />
                <Slider Grid.Column="1" Minimum="-100" Maximum="100" Value="{Binding Brightness}" TickFrequency="1" IsSnapToTickEnabled="True"
                        SmallChange="1" LargeChange="10" VerticalAlignment="Center" AutomationProperties.Name="{DynamicResource image_edit.brightness}" />
                <TextBlock Grid.Column="2" Classes="value" Text="{Binding BrightnessText}" />
                <Button Grid.Column="3" Classes="reset" Command="{Binding ResetLightCommand}" CommandParameter="brightness" HorizontalAlignment="Right"
                        ToolTip.Tip="{DynamicResource crop.reset}" AutomationProperties.Name="{DynamicResource crop.reset}">
                  <PathIcon Width="13" Height="13" Data="{StaticResource Mandarin.Reset}" />
                </Button>
              </Grid>
              <Grid ColumnDefinitions="110,*,78,30">
                <TextBlock Text="{DynamicResource image_edit.contrast}" VerticalAlignment="Center" FontSize="13.5" />
                <Slider Grid.Column="1" Minimum="-100" Maximum="100" Value="{Binding Contrast}" TickFrequency="1" IsSnapToTickEnabled="True"
                        SmallChange="1" LargeChange="10" VerticalAlignment="Center" AutomationProperties.Name="{DynamicResource image_edit.contrast}" />
                <TextBlock Grid.Column="2" Classes="value" Text="{Binding ContrastText}" />
                <Button Grid.Column="3" Classes="reset" Command="{Binding ResetLightCommand}" CommandParameter="contrast" HorizontalAlignment="Right"
                        ToolTip.Tip="{DynamicResource crop.reset}" AutomationProperties.Name="{DynamicResource crop.reset}">
                  <PathIcon Width="13" Height="13" Data="{StaticResource Mandarin.Reset}" />
                </Button>
              </Grid>
              <Grid ColumnDefinitions="110,*,78,30">
                <TextBlock Text="{DynamicResource image_edit.highlights}" VerticalAlignment="Center" FontSize="13.5" />
                <Slider Grid.Column="1" Minimum="-100" Maximum="100" Value="{Binding Highlights}" TickFrequency="1" IsSnapToTickEnabled="True"
                        SmallChange="1" LargeChange="10" VerticalAlignment="Center" AutomationProperties.Name="{DynamicResource image_edit.highlights}" />
                <TextBlock Grid.Column="2" Classes="value" Text="{Binding HighlightsText}" />
                <Button Grid.Column="3" Classes="reset" Command="{Binding ResetLightCommand}" CommandParameter="highlights" HorizontalAlignment="Right"
                        ToolTip.Tip="{DynamicResource crop.reset}" AutomationProperties.Name="{DynamicResource crop.reset}">
                  <PathIcon Width="13" Height="13" Data="{StaticResource Mandarin.Reset}" />
                </Button>
              </Grid>
              <Grid ColumnDefinitions="110,*,78,30">
                <TextBlock Text="{DynamicResource image_edit.shadows}" VerticalAlignment="Center" FontSize="13.5" />
                <Slider Grid.Column="1" Minimum="-100" Maximum="100" Value="{Binding Shadows}" TickFrequency="1" IsSnapToTickEnabled="True"
                        SmallChange="1" LargeChange="10" VerticalAlignment="Center" AutomationProperties.Name="{DynamicResource image_edit.shadows}" />
                <TextBlock Grid.Column="2" Classes="value" Text="{Binding ShadowsText}" />
                <Button Grid.Column="3" Classes="reset" Command="{Binding ResetLightCommand}" CommandParameter="shadows" HorizontalAlignment="Right"
                        ToolTip.Tip="{DynamicResource crop.reset}" AutomationProperties.Name="{DynamicResource crop.reset}">
                  <PathIcon Width="13" Height="13" Data="{StaticResource Mandarin.Reset}" />
                </Button>
              </Grid>
          </StackPanel>

          <!-- Size, format, turn and colour -->
          <StackPanel Spacing="12">
            <TextBlock Classes="section" Text="{DynamicResource image_edit.size_format}" />
            <TextBlock Classes="caption" TextWrapping="Wrap" Text="{DynamicResource image_edit.hint}" />
            <StackPanel>
              <TextBlock Classes="label" Text="{DynamicResource presets.target}" />
              <ComboBox x:Name="TargetChoice" ItemsSource="{Binding Targets}" SelectedItem="{Binding Target}" HorizontalAlignment="Stretch"
                        AutomationProperties.Name="{DynamicResource presets.target}" />
            </StackPanel>

            <Grid ColumnDefinitions="3*,12,2*">
              <StackPanel>
                <TextBlock Classes="label" Text="{DynamicResource presets.resize}" />
                <ComboBox x:Name="ResizeChoice" ItemsSource="{Binding ResizeModes}" SelectedItem="{Binding Resize}" HorizontalAlignment="Stretch"
                          AutomationProperties.Name="{DynamicResource presets.resize}" />
              </StackPanel>
              <StackPanel Grid.Column="2" IsVisible="{Binding ShowPercent}">
                <TextBlock Classes="label" Text="{DynamicResource presets.percent}" />
                <NumericUpDown Value="{Binding ResizePercent}" Minimum="1" Maximum="1000" Increment="5" FormatString="0" ShowButtonSpinner="False" AutomationProperties.Name="{DynamicResource presets.percent}" />
              </StackPanel>
              <StackPanel Grid.Column="2" IsVisible="{Binding ShowLongEdge}">
                <TextBlock Classes="label" Text="{DynamicResource presets.long_edge}" />
                <NumericUpDown Value="{Binding LongEdge}" Minimum="16" Maximum="20000" Increment="100" FormatString="0" ShowButtonSpinner="False" AutomationProperties.Name="{DynamicResource presets.long_edge}" />
              </StackPanel>
              <StackPanel Grid.Column="2" IsVisible="{Binding ShowWidth}">
                <TextBlock Classes="label" Text="{DynamicResource presets.width}" />
                <NumericUpDown Value="{Binding Width}" Minimum="16" Maximum="20000" Increment="100" FormatString="0" ShowButtonSpinner="False" AutomationProperties.Name="{DynamicResource presets.width}" />
              </StackPanel>
            </Grid>
            <!-- Width × height (#725), in px, cm, mm or inches; a size in cm, mm or inches becomes pixels at the DPI. -->
            <StackPanel x:Name="CustomSize" Spacing="8" IsVisible="{Binding ShowCustom}">
              <Grid ColumnDefinitions="*,8,Auto,8,*,12,Auto">
                <StackPanel>
                  <TextBlock Classes="label" Text="{DynamicResource image_edit.width}" />
                  <NumericUpDown x:Name="CustomWidthBox" Value="{Binding CustomWidth}" Minimum="0.1" Maximum="16384" Increment="1" FormatString="{Binding SizeFormat}"
                                 ShowButtonSpinner="False" HorizontalContentAlignment="Center" ToolTip.Tip="{DynamicResource presets.custom_size_empty_hint}"
                                 AutomationProperties.Name="{DynamicResource image_edit.width}" />
                </StackPanel>
                <TextBlock Grid.Column="2" Text="×" VerticalAlignment="Bottom" Margin="0,0,0,8" />
                <StackPanel Grid.Column="4">
                  <TextBlock Classes="label" Text="{DynamicResource image_edit.height}" />
                  <NumericUpDown x:Name="CustomHeightBox" Value="{Binding CustomHeight}" Minimum="0.1" Maximum="16384" Increment="1" FormatString="{Binding SizeFormat}"
                                 ShowButtonSpinner="False" HorizontalContentAlignment="Center" ToolTip.Tip="{DynamicResource presets.custom_size_empty_hint}"
                                 AutomationProperties.Name="{DynamicResource image_edit.height}" />
                </StackPanel>
                <StackPanel Grid.Column="6">
                  <TextBlock Classes="label" Text="{DynamicResource image_edit.unit}" />
                  <ComboBox x:Name="UnitChoice" ItemsSource="{Binding Units}" SelectedItem="{Binding Unit}" MinWidth="110"
                            AutomationProperties.Name="{DynamicResource image_edit.unit}" />
                </StackPanel>
              </Grid>
              <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8" IsVisible="{Binding ShowDpi}">
                  <TextBlock Text="{DynamicResource presets.dpi}" VerticalAlignment="Center" />
                  <NumericUpDown x:Name="DpiBox" Value="{Binding Dpi}" Minimum="1" Maximum="9600" Increment="10" FormatString="0" Width="90"
                                 ShowButtonSpinner="False" HorizontalContentAlignment="Center" AutomationProperties.Name="{DynamicResource presets.dpi}" />
                </StackPanel>
                <StackPanel Spacing="4" VerticalAlignment="Center">
                  <CheckBox x:Name="LockAspectBox" Content="{DynamicResource presets.lock_aspect}" IsChecked="{Binding LockAspect}" VerticalAlignment="Center" />
                  <!-- #1270: with the shape kept, the box can be a maximum that leaves smaller pictures as they are. -->
                  <CheckBox x:Name="ShrinkOnlyBox" Content="{DynamicResource presets.never_enlarge}" IsChecked="{Binding ShrinkOnly}" IsVisible="{Binding LockAspect}"
                            VerticalAlignment="Center" ToolTip.Tip="{DynamicResource presets.never_enlarge_hint}" />
                </StackPanel>
              </DockPanel>
              <TextBlock x:Name="CustomSizeErrorText" Classes="caption danger" TextWrapping="Wrap" Text="{Binding CustomSizeError}"
                         IsVisible="{Binding CustomSizeError, Converter={x:Static ObjectConverters.IsNotNull}}" />
            </StackPanel>
            <!-- The first picture's size before and after. Each size stays "width × height" in Arabic too; the arrow and their
                 order follow the reading direction. -->
            <StackPanel x:Name="SizeChange" Orientation="Horizontal" Spacing="6" IsVisible="{Binding ShowSize}">
              <TextBlock Classes="caption" Text="{Binding SizeBefore}" FlowDirection="LeftToRight" />
              <TextBlock Classes="caption" Text="{DynamicResource AppForwardArrow}" />
              <TextBlock Classes="caption" Text="{Binding SizeAfter}" FlowDirection="LeftToRight" FontWeight="SemiBold" />
            </StackPanel>

            <Grid ColumnDefinitions="3*,12,2*">
              <StackPanel>
                <TextBlock Classes="label" Text="{DynamicResource presets.rotation}" />
                <ComboBox ItemsSource="{Binding Rotations}" SelectedItem="{Binding Rotation}" HorizontalAlignment="Stretch"
                          AutomationProperties.Name="{DynamicResource presets.rotation}" />
              </StackPanel>
              <StackPanel Grid.Column="2">
                <TextBlock Classes="label" Text="{DynamicResource presets.flip}" />
                <ComboBox ItemsSource="{Binding Flips}" SelectedItem="{Binding Flip}" HorizontalAlignment="Stretch"
                          AutomationProperties.Name="{DynamicResource presets.flip}" />
              </StackPanel>
            </Grid>

            <StackPanel IsVisible="{Binding ShowQuality}">
              <DockPanel>
                <TextBlock DockPanel.Dock="Right" Text="{Binding Quality}" FontWeight="SemiBold" />
                <TextBlock Classes="label" Text="{DynamicResource presets.quality}" />
              </DockPanel>
              <Slider Minimum="1" Maximum="100" Value="{Binding Quality}" TickFrequency="1" IsSnapToTickEnabled="True" AutomationProperties.Name="{DynamicResource presets.quality}" />
            </StackPanel>

            <CheckBox x:Name="GrayscaleBox" Content="{DynamicResource presets.grayscale}" IsChecked="{Binding Grayscale}" />
          </StackPanel>
        </StackPanel>
      </ScrollViewer>

      <!-- Cancel and Convert -->
      <StackPanel Grid.Row="4">
        <Border Classes="hairline" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="24,12,24,16">
          <Button x:Name="CancelEdit" Content="{DynamicResource common.cancel}" Click="OnCancel" IsCancel="True" />
          <Button x:Name="StartEdit" Classes="accent" Content="{DynamicResource image_edit.convert}" Click="OnConvert" IsDefault="True"
                  IsEnabled="{Binding CanConvert}" MinWidth="96" HorizontalContentAlignment="Center" />
        </StackPanel>
      </StackPanel>
    </Grid>
  </Border>
</Window>
